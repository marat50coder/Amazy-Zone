<?xml version="1.0" encoding="utf-8"?>
<!-- Hand-written to match the SkyLadder project layout: a single webp lives in
     drawable-nodpi and is inset within the adaptive mask. The legacy mipmaps
     for pre-API-26 devices are generated by flutter_launcher_icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launch_bg" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_art"
            android:inset="17%" />
    </foreground>
</adaptive-icon>
